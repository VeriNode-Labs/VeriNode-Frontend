{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VeriNode",
  "version": "0.1.0",
  "identifier": "labs.verinode.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VeriNode Analytics",
        "width": 1240,
        "height": 820,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}